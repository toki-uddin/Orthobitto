  "shortcuts": [
    {
      "name": "Scan New Image",
      "short_name": "Scan",
      "description": "Open Orthobitto and upload a new image for OCR",
      "url": "./index.html#scanner",
      "icons": [
        {
          "src": "icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "View History",
      "short_name": "History",
      "description": "View previous scan history",
      "url": "./index.html#history",
      "icons": [
        {
          "src": "icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+orthobitto",
      "url": "./index.html?q=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "related_applications": [],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "image/webp": [
          ".webp"
        ]
      },
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        }
      ]
    }
  },
  "id": "./",
  "version": "4.1.2-github-pdf-fix"
}