{
  "project": "Orthobitto",
  "version": "4.1.2",
  "release": "github-pdf-fix",
  "theme": [
    "system",
    "light",
    "dark"
  ],
  "dictionaryMode": "approved-local-first",
  "androidRelease": false,
  "futureDictionaryMergeReady": true,
  "primaryRuntime": [
    "HTML5",
    "CSS3",
